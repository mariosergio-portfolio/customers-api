  <diagram id="p10-UMLStateE" name="UML State: Email job">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p10-UMLStateE-1" value="UML state machine: email job lifecycle (planned)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="36" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-2" value="Only needed if drafts are persisted. One job per matching customer; the request as a whole is done when every job is terminal." style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#555555;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1400" height="36" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-3" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="285" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-4" value="&lt;b&gt;DRAFTED&lt;/b&gt;&lt;br&gt;Bedrock wrote subject + body" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="270" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-5" value="&lt;b&gt;PENDING_APPROVAL&lt;/b&gt;&lt;br&gt;preview shown to user" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="270" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-6" value="&lt;b&gt;APPROVED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="270" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-7" value="&lt;b&gt;SENDING&lt;/b&gt;&lt;br&gt;SES SendEmail" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="270" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-8" value="&lt;b&gt;SENT&lt;/b&gt;&lt;br&gt;SES messageId stored" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="180" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-9" value="&lt;b&gt;FAILED&lt;/b&gt;&lt;br&gt;error stored" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="360" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-10" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;user removed the draft" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-11" value="&lt;b&gt;EXPIRED&lt;/b&gt;&lt;br&gt;no approval in time" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-12" value="&lt;b&gt;GAVE_UP&lt;/b&gt;&lt;br&gt;retries exhausted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="520" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-13" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1400" y="195" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="p10-UMLStateE-14" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=open;endSize=8;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p10-UMLStateE-3" target="p10-UMLStateE-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p10-UMLStateE-15" value="drafts returned" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=open;endSize=8;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p10-UMLStateE-4" target="p10-UMLStateE-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p10-UMLStateE-16" value="approve" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=open;endSize=8;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p10-UMLStateE-5" target="p10-UMLStateE-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p10-UMLStateE-17" value="send" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=open;endSize=8;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p10-UMLStateE-6" target="p10-UMLStateE-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p10-UMLStateE-18" value="accepted by SES" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=open;endSize=8;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p10-UMLStateE-7" target="p10-UMLStateE-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p10-UMLStateE-19" value="error / throttled" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=open;endSize=8;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p10-UMLStateE-7" target="p10-UMLStateE-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p10-UMLStateE-20" value="remove / reject" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=open;endSize=8;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p10-UMLStateE-5" target="p10-UMLStateE-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p10-UMLStateE-21" value="TTL elapsed" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=open;endSize=8;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p10-UMLStateE-5" target="p10-UMLStateE-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p10-UMLStateE-22" value="retry (attempt &lt; N, backoff)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=open;endSize=8;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;flowAnimation=1;" edge="1" parent="1" source="p10-UMLStateE-9" target="p10-UMLStateE-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="390"/></Array></mxGeometry></mxCell>
        <mxCell id="p10-UMLStateE-23" value="attempt = N" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=open;endSize=8;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p10-UMLStateE-9" target="p10-UMLStateE-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p10-UMLStateE-24" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=open;endSize=8;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p10-UMLStateE-8" target="p10-UMLStateE-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p10-UMLStateE-25" value="SENT, REJECTED, EXPIRED and GAVE_UP are terminal. Each transition is written to the audit log." style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="150" y="620" width="900" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p11-DataFlowN" name="Data flow: NL assistant">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p11-DataFlowN-1" value="Data flow and trust boundaries: natural-language assistant (planned)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="36" as="geometry"/></mxCell>
        <mxCell id="p11-DataFlowN-2" value="What crosses each boundary. The model never receives the customer table or email addresses; the recipient cap, approval step and IAM scope limit what an action can do." style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#555555;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1400" height="36" as="geometry"/></mxCell>
        <mxCell id="p11-DataFlowN-3" value="&lt;b&gt;Trusted zone: ECS task (Java or Node service)&lt;/b&gt;" style="rounded=0;arcSize=4;dashed=1;fillColor=none;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;strokeColor=#2E73B8;fontColor=#2E73B8;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="760" height="560" as="geometry"/></mxCell>
        <mxCell id="p11-DataFlowN-4" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;portfolio-frontend (browser)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="340" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="p11-DataFlowN-5" value="&lt;b&gt;AssistantController&lt;/b&gt;&lt;br&gt;auth, request size limit" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="p11-DataFlowN-6" value="&lt;b&gt;Validation&lt;/b&gt;&lt;br&gt;allowlist orderBy · limit ≤ MAX_LIMIT&lt;br&gt;drop unknown fields" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="300" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="p11-DataFlowN-7" value="&lt;b&gt;AssistantService&lt;/b&gt;&lt;br&gt;cap · country→language · audit log" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="450" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="p11-DataFlowN-8" value="&lt;b&gt;Approval gate&lt;/b&gt;&lt;br&gt;send only approved ids" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="780" y="450" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="p11-DataFlowN-9" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;table customer" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="780" y="190" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="p11-DataFlowN-10" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;InvokeModel" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5f0e9;strokeColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="1250" y="250" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="p11-DataFlowN-11" value="&lt;b&gt;Amazon SES&lt;/b&gt;&lt;br&gt;SendEmail" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fce4ef;strokeColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="1250" y="600" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="p11-DataFlowN-12" value="1  prompt (free text)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p11-DataFlowN-4" target="p11-DataFlowN-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="190"/></Array></mxGeometry></mxCell>
        <mxCell id="p11-DataFlowN-13" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p11-DataFlowN-5" target="p11-DataFlowN-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p11-DataFlowN-14" value="2  prompt only" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#01A88D;flowAnimation=1;" edge="1" parent="1" source="p11-DataFlowN-5" target="p11-DataFlowN-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="160"/><mxPoint x="1350" y="160"/></Array></mxGeometry></mxCell>
        <mxCell id="p11-DataFlowN-15" value="3  filters JSON (untrusted)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#01A88D;dashed=1;flowAnimation=1;" edge="1" parent="1" source="p11-DataFlowN-10" target="p11-DataFlowN-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="335"/><mxPoint x="450" y="335"/></Array></mxGeometry></mxCell>
        <mxCell id="p11-DataFlowN-16" value="4  validated filters" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p11-DataFlowN-6" target="p11-DataFlowN-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p11-DataFlowN-17" value="5  parameterized query" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p11-DataFlowN-7" target="p11-DataFlowN-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="485"/><mxPoint x="620" y="225"/></Array></mxGeometry></mxCell>
        <mxCell id="p11-DataFlowN-18" value="6  customer rows" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;flowAnimation=1;" edge="1" parent="1" source="p11-DataFlowN-9" target="p11-DataFlowN-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="225"/><mxPoint x="700" y="505"/></Array></mxGeometry></mxCell>
        <mxCell id="p11-DataFlowN-19" value="7  per customer: firstName, country, language" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#01A88D;flowAnimation=1;" edge="1" parent="1" source="p11-DataFlowN-7" target="p11-DataFlowN-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="540"/><mxPoint x="1130" y="540"/><mxPoint x="1130" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="p11-DataFlowN-20" value="8  subject + body" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#01A88D;dashed=1;flowAnimation=1;" edge="1" parent="1" source="p11-DataFlowN-10" target="p11-DataFlowN-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="380"/><mxPoint x="1400" y="560"/><mxPoint x="560" y="560"/></Array></mxGeometry></mxCell>
        <mxCell id="p11-DataFlowN-21" value="9  drafts (preview) + requestId" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;flowAnimation=1;" edge="1" parent="1" source="p11-DataFlowN-7" target="p11-DataFlowN-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="630"/><mxPoint x="125" y="630"/></Array></mxGeometry></mxCell>
        <mxCell id="p11-DataFlowN-22" value="10  approve(ids)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;flowAnimation=1;" edge="1" parent="1" source="p11-DataFlowN-4" target="p11-DataFlowN-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="740"/><mxPoint x="890" y="740"/></Array></mxGeometry></mxCell>
        <mxCell id="p11-DataFlowN-23" value="11  to (email), subject, body" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#E7157B;flowAnimation=1;" edge="1" parent="1" source="p11-DataFlowN-8" target="p11-DataFlowN-11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="480"/><mxPoint x="1130" y="635"/></Array></mxGeometry></mxCell>
        <mxCell id="p11-DataFlowN-24" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;① orderBy/limit allowlist, unknown fields dropped&lt;br&gt;② model output is untrusted: never used as SQL&lt;br&gt;③ MAX_RECIPIENTS cap per request&lt;br&gt;④ human approval before any send&lt;br&gt;⑤ audit log: prompt, filters, ids, sender&lt;br&gt;⑥ task role: bedrock:InvokeModel (one model), ses:SendEmail (verified identity)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;strokeColor=#cccccc;fillColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="760" height="150" as="geometry"/></mxCell>
        <mxCell id="p11-DataFlowN-25" value="&lt;b&gt;Bedrock sees&lt;/b&gt;: the prompt and, per email, first name + country + language.&lt;br&gt;&lt;b&gt;Bedrock never sees&lt;/b&gt;: the customer table, email addresses, ids, other columns." style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;align=left;verticalAlign=top;strokeColor=#cccccc;fillColor=#ffffff;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="800" width="700" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
