        <mxCell id="p8-UMLSequenceN-3" value="POST /api/assistant/requests&lt;br&gt;{ companyId, prompt }" style="html=1;verticalAlign=bottom;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;flowAnimation=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="185" as="sourcePoint"/><mxPoint x="300" y="185" as="targetPoint"/></mxGeometry></mxCell>
