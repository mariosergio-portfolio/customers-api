<mxfile host="app.diagrams.net" agent="customers-api generator" version="24.7.17"><diagram id="p1-AWSArchitect" name="AWS Architecture (AWS17)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-AWSArchitect-1" value="Customers API: AWS architecture (AWS17 shapes)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="p1-AWSArchitect-2" value="Reference deployment for both implementations. The Java (Spring Boot) and Node (Express) services expose the same REST contract and are interchangeable behind the load balancer. Both use the AWS default credentials chain: ECS task role in AWS, &lt;i&gt;aws login&lt;/i&gt; session locally." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1400" height="36" as="geometry"/></mxCell><mxCell id="p1-AWSArchitect-3" value="Portfolio visitors" style="outlineConnect=0;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;shape=mxgraph.aws3.users;fillColor=#D2D3D3;gradientColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="66" height="63" as="geometry"/></mxCell><mxCell id="p1-AWSArchitect-4" value="&lt;b&gt;portfolio-frontend&lt;/b&gt;&lt;br&gt;React SPA (browser)" style="outlineConnect=0;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;shape=mxgraph.aws3.management_console;fillColor=#D2D3D3;gradientColor=none;" vertex="1" parent="1"><mxGeometry x="180" y="330" width="63" height="63" as="geometry"/></mxCell><mxCell id="p1-AWSArchitect-5" value="Internet" st