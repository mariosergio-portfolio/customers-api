        <mxCell id="p8-UMLSequenceN-1" value="UML sequence: natural-language assistant (planned)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="36" as="geometry"/></mxCell>
        <mxCell id="p8-UMLSequenceN-2" value="POST /api/assistant/requests → Bedrock extracts filters → search → Bedrock drafts one email per customer → preview → approval → SES. Same flow in the Java and Node services." style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#555555;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1400" height="36" as="geometry"/></mxCell>
        <mxCell id="p8-UMLSequenceN-34" value="&lt;b&gt;:portfolio-frontend&lt;/b&gt;&lt;br&gt;(user)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="160" height="1185" as="geometry"/></mxCell>
        <mxCell id="p8-UMLSequenceN-35" value="&lt;b&gt;:AssistantController&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="220" y="100" width="160" height="1185" as="geometry"/></mxCell>
        <mxCell id="p8-UMLSequenceN-36" value="&lt;b&gt;:AssistantService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="410" y="100" width="160" height="1185" as="geometry"/></mxCell>
        <mxCell id="p8-UMLSequenceN-37" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;InvokeModel" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=11;fillColor=#d5f0e9;strokeColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="160" height="1185" as="geometry"/></mxCell>
        <mxCell id="p8-UMLSequenceN-38" value="&lt;b&gt;:CustomerRepository&lt;/b&gt;&lt;br&gt;+ PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="790" y="100" width="160" height="1185" as="geometry"/></mxCell>
