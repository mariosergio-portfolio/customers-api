        <mxCell id="p7-UMLActivityR-48" value="&lt;b&gt;Status mapping: Java vs Node&lt;/b&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;margin-top:6px;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th align=&quot;left&quot;&gt;Case&lt;/th&gt;&lt;th&gt;Java&lt;/th&gt;&lt;th&gt;Node&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;bad companyId / UUID&lt;/td&gt;&lt;td&gt;400&lt;/td&gt;&lt;td&gt;400&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;unknown orderBy&lt;/td&gt;&lt;td&gt;200 (id)&lt;/td&gt;&lt;td&gt;400&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;customer not found&lt;/td&gt;&lt;td&gt;500*&lt;/td&gt;&lt;td&gt;404&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;unsupported language&lt;/td&gt;&lt;td&gt;500&lt;/td&gt;&lt;td&gt;400&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Polly failure&lt;/td&gt;&lt;td&gt;500&lt;/td&gt;&lt;td&gt;502&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rate limit&lt;/td&gt;&lt;td&gt;n/a&lt;/td&gt;&lt;td&gt;429&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;unknown route&lt;/td&gt;&lt;td&gt;404 / 500&lt;/td&gt;&lt;td&gt;404&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;* ResponseStatusException is caught by the catch-all &lt;i&gt;@ExceptionHandler(Exception.class)&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
